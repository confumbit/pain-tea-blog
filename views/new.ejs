<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="/style.css">
    <title>Write Blog</title>
</head>
<body>
   <div class="header blogpage">
        <a href="/">
            <img src="/logo.png" alt="logo- a blog" class="logo">
            <div class="blog-name">a blog</div>
        </a>
   </div>
   <div class="header">
       <h1 style="text-align: center; font-weight: 400;">Write a New Blog</h1>
   </div>
   <form action="/add/" method="post" class="form" enctype="multipart/form-data">
    <input type="text" name="title" id="title" placeholder="title" required>
    <input type="text" name="subtitle" id="subtitle" placeholder="subtitle" required>

    <div class="author-section">
        <div id="author-image-preview" style="display: flex;align-items: center; gap: 10px;">
            <input type="text" name="author" id="author" placeholder="author" required onblur="fetchAuthorImage()">
            <img src="https://i.imgur.com/eKfRhGQ.png" alt="Default Image" id="existing-author-image" width="30px">
            <input type="file" name="authorImage" id="authorImage">
        </div>
    </div>

    <textarea name="article" id="article" class="article" placeholder="Write the article here" required></textarea>
    <input type="submit" value="Submit">
</form>

<script>
async function fetchAuthorImage() {
    const author = document.getElementById("author").value;
    if (!author) return;

    const response = await fetch(`/author-image?author=${encodeURIComponent(author)}`);
    const data = await response.json();

    if (data.image) {
        document.getElementById("existing-author-image").src = data.image;
    } else {
        document.getElementById("existing-author-image").src = "https://i.imgur.com/eKfRhGQ.png";
    }
}
</script>

</body>
</html>